---
interface Props {
  id: string;
  class?: string;
}

const { id, class: className = '' } = Astro.props;

const inputClass =
  'w-full bg-covacsa-gray-light border border-gray-300 rounded-xl px-4 py-3 text-sm text-covacsa-dark focus:outline-none focus:border-covacsa-red focus:ring-2 focus:ring-covacsa-red/20 transition-colors';
const labelClass = 'block text-xs font-bold uppercase text-covacsa-blue mb-2';
---

<!-- Mismos campos que la LP actual (nombre, correo, telefono, mensaje + utm_*) -->
<form id={id} class:list={['lead-form bg-white text-covacsa-dark rounded-3xl p-6 sm:p-8 shadow-2xl space-y-5', className]} novalidate>
  <p class="text-xl font-black text-covacsa-blue">Cotiza tus soluciones industriales:</p>

  <div>
    <label for={`${id}-nombre`} class={labelClass}>Nombre y Apellido *</label>
    <input id={`${id}-nombre`} name="nombre" type="text" autocomplete="name" required minlength="3" class={inputClass} />
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div>
      <label for={`${id}-correo`} class={labelClass}>Email *</label>
      <input id={`${id}-correo`} name="correo" type="email" autocomplete="email" required class={inputClass} />
    </div>
    <div>
      <label for={`${id}-telefono`} class={labelClass}>Teléfono *</label>
      <input id={`${id}-telefono`} name="telefono" type="tel" inputmode="tel" autocomplete="tel" required minlength="10" class={inputClass} />
    </div>
  </div>

  <div>
    <label for={`${id}-mensaje`} class={labelClass}>Comentarios</label>
    <textarea id={`${id}-mensaje`} name="mensaje" rows="3" placeholder="Producto, medida, material y cantidad" class={inputClass}></textarea>
  </div>

  <input type="hidden" name="utm_id" />
  <input type="hidden" name="utm_campaign" />
  <input type="hidden" name="utm_source" />
  <input type="hidden" name="utm_medium" />
  <input type="hidden" name="utm_content" />
  <input type="hidden" name="utm_term" />

  <!-- Honeypot antispam: invisible para personas; si llega con valor, no se envía -->
  <div class="absolute -left-[9999px] w-px h-px overflow-hidden" aria-hidden="true">
    <label for={`${id}-sitio`}>No llenar este campo</label>
    <input id={`${id}-sitio`} name="sitio_web" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <button type="submit" class="w-full bg-covacsa-red hover:bg-red-700 text-white font-extrabold text-base py-4 rounded-xl transition-all duration-300 shadow-lg shadow-covacsa-red/30 hover:-translate-y-0.5 flex items-center justify-center gap-2 disabled:opacity-60 disabled:hover:translate-y-0">
    <i class="ph ph-paper-plane-tilt text-xl"></i>
    <span>Enviar</span>
  </button>

  <p class="lead-form-status text-center text-xs text-gray-500 min-h-4" aria-live="polite"></p>
</form>

<script>
  import { BASE, CONTACTO } from '../data/covacsa';

  const TELEFONO = CONTACTO.telefono;
  const CORREO = CONTACTO.correo;
  const params = new URLSearchParams(window.location.search);

  document.querySelectorAll<HTMLFormElement>('.lead-form').forEach((form) => {
    // Rellena los UTM una sola vez por formulario
    if (form.dataset.ready) return;
    form.dataset.ready = '1';

    form.querySelectorAll<HTMLInputElement>('input[name^="utm_"]').forEach((input) => {
      input.value = params.get(input.name) ?? '';
    });

    const status = form.querySelector<HTMLElement>('.lead-form-status');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const setStatus = (text: string, error = false) => {
      if (!status) return;
      status.textContent = text;
      status.classList.toggle('text-covacsa-red', error);
      status.classList.toggle('font-bold', error);
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      const gracias = `${BASE}gracias.html`;

      // Bot: finge éxito sin enviar el lead
      if (data.get('sitio_web')) {
        window.location.href = gracias;
        return;
      }
      data.delete('sitio_web');

      if (button) button.disabled = true;
      setStatus('Enviando…');

      try {
        // Mismo endpoint de la LP anterior: reenvía a Omnia y Ongoing (correo a ventas@covacsa.com.mx)
        const res = await fetch(`${BASE}_send.php`, { method: 'POST', body: data });
        const result = await res.json();

        if (!result.estatus) {
          setStatus(result.message || 'No pudimos enviar tus datos. Revisa la información e intenta de nuevo.', true);
          if (button) button.disabled = false;
          return;
        }

        const dataLayer = ((window as any).dataLayer ??= []);
        dataLayer.push({ event: 'generate_lead', form_id: form.id });
        form.reset();
        window.location.href = gracias;
      } catch (error) {
        console.error('[lead-form]', error);
        setStatus(`No pudimos enviar tus datos. Llámanos al ${TELEFONO} o escríbenos a ${CORREO}.`, true);
        if (button) button.disabled = false;
      }
    });
  });
</script>
