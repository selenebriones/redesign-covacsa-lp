---
import '@phosphor-icons/web/regular';
import '../styles/global.css';
import { BASE, IMG, CONTACTO, SITIO, GTM_ID } from '../data/covacsa';

interface Props {
  title: string;
  description?: string;
  /** Páginas que no deben indexarse (gracias) */
  noindex?: boolean;
}

const {
  title,
  noindex = false,
  description = 'Válvulas, tuberías, bridas y conexiones industriales en Monterrey, Nuevo León. 20 años de experiencia y embarques a toda la República. Cotiza con Covacsa.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname.replace(/index\.html$/, ''), SITIO).href;
const ogImage = new URL(`${BASE}og-covacsa.jpg`, SITIO).href;

// En el inicio las anclas van solas para no recargar la página (y perder los UTM de la URL)
const enInicio = Astro.url.pathname === BASE || Astro.url.pathname === `${BASE}index.html`;
const ancla = (id: string) => (enInicio ? id : `${BASE}${id}`);

const nav = [
  { href: ancla('#valvulas'), label: 'Válvulas' },
  { href: ancla('#tuberias'), label: 'Tuberías' },
  { href: ancla('#conexiones'), label: 'Conexiones' },
  { href: ancla('#contacto'), label: 'Contacto' },
];
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <!-- Google Tag Manager (carga GA4 y Google Ads) -->
    <script is:inline define:vars={{ gtmId: GTM_ID }}>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtmId);
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#022b62" />
    <title>{title}</title>
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="Covacsa" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href={`${BASE}favicon-96x96.png`} sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
    <link rel="shortcut icon" href={`${BASE}favicon.ico`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${BASE}apple-touch-icon.png`} />
    <meta name="apple-mobile-web-app-title" content="Covacsa" />
    <link rel="manifest" href={`${BASE}site.webmanifest`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-covacsa-white text-covacsa-dark font-sans antialiased">
    <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <header class="fixed inset-x-0 top-0 z-50 bg-white/90 backdrop-blur border-b border-gray-200">
      <div class="max-w-7xl mx-auto px-6 h-18 flex items-center justify-between gap-6">
        <a href={enInicio ? '#' : BASE} aria-label="Covacsa, inicio">
          <img src={`${IMG}/covacsa-logotipo-color.webp`} alt="Covacsa" width="300" height="201" class="h-12 w-auto" />
        </a>

        <nav class="hidden lg:flex items-center gap-8 text-sm font-semibold text-covacsa-blue">
          {nav.map((item) => (
            <a href={item.href} class="hover:text-covacsa-red transition-colors">{item.label}</a>
          ))}
        </nav>

        <div class="flex items-center gap-3">
          <a href={CONTACTO.telefonoHref} class="hidden sm:inline-flex items-center gap-2 text-sm font-bold text-covacsa-blue hover:text-covacsa-red transition-colors">
            <i class="ph ph-phone text-lg"></i>
            <span>{CONTACTO.telefono}</span>
          </a>
          <a href={ancla('#contacto')} class="inline-flex items-center gap-2 bg-covacsa-red hover:bg-red-700 text-white text-sm font-bold px-4 py-2.5 rounded-lg transition-colors">
            <i class="ph ph-file-text text-base"></i>
            <span>Cotizar</span>
          </a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="bg-covacsa-dark text-gray-400 text-sm">
      <div class="max-w-7xl mx-auto px-6 py-10 flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
        <img src={`${IMG}/covacsa-logotipo.webp`} alt="Covacsa" width="300" height="200" class="h-14 w-auto" loading="lazy" />
        <div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-8 text-gray-300">
          <a href={CONTACTO.telefonoHref} class="inline-flex items-center gap-2 hover:text-white transition-colors">
            <i class="ph ph-phone text-lg text-covacsa-red"></i> {CONTACTO.telefono}
          </a>
          <a href={`mailto:${CONTACTO.correo}`} class="inline-flex items-center gap-2 hover:text-white transition-colors">
            <i class="ph ph-envelope-simple text-lg text-covacsa-red"></i> {CONTACTO.correo}
          </a>
        </div>
      </div>
      <div class="border-t border-white/10">
        <p class="max-w-7xl mx-auto px-6 py-5 text-xs text-center md:text-left">
          {new Date().getFullYear()}© Covacsa. Todos los derechos reservados. Diseño y desarrollo por{" "}
          <a href="https://www.futurite.com/" class="underline hover:text-white" target="_blank" rel="noopener">agencia de marketing digital Futurité</a>.
        </p>
      </div>
    </footer>
  </body>
</html>
